# Copia este archivo a `.env` y ajusta los valores.
# NUNCA subas `.env` con credenciales reales al repositorio.

# Entorno de ejecución: development, production o testing.
FLASK_CONFIG=development

# Clave secreta de Flask (sesiones, CSRF, etc.).
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# Cadena de conexión a SQLite para desarrollo.
# En producción con PostgreSQL (Vercel/Neon, Render, Railway...) define
# DATABASE_URL (o SQLALCHEMY_DATABASE_URI) apuntando a la base.
# Ejemplo Neon: postgresql://usuario:password@host/dbname?sslmode=require
SQLALCHEMY_DATABASE_URI=sqlite:///sistema_alimentos.db

# PostgreSQL en producción (opcional; tiene prioridad sobre
# SQLALCHEMY_DATABASE_URI). Déjalo vacío para usar SQLite en desarrollo.
DATABASE_URL=

# Nivel de detalle de logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---- Cookies de sesión ----
# Poner a "true" solo si el sitio se sirve por HTTPS (producción).
SESSION_COOKIE_SECURE=false

# ---- Integración (opcional) ----
# Google Analytics / gtag. Vacío = desactivado.
# Ejemplo: ANALYTICS_TAG=G-XXXXXXXXXX
ANALYTICS_TAG=

# ---- Usuario administrador inicial ----
# Se crea automáticamente al iniciar la aplicación la primera vez
# (ver services/init_services.py).
ADMIN_NOMBRE=Administrador
ADMIN_USUARIO=admin
ADMIN_PASSWORD=admin123
ADMIN_ROL=admin
